# Allcited Backend Configuration Template (api/.env.example)
# Copy this file to api/.env and fill in your keys. NEVER commit .env to git!

# ==============================================================================
# Core Environment & Server
# ==============================================================================
# Environment mode: 'development', 'test', or 'production'.
# In 'production', fail-closed validation strictly enforces all mandatory secrets at boot.
ENVIRONMENT=development
PORT=8000
# Operating mode: 'cloud' (Groq/NVIDIA LLMs) or 'private' (local Ollama only)
MODE=cloud
# Allowed CORS origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://allcited.vercel.app

# ==============================================================================
# LLM Brain & Fallback Settings
# ==============================================================================
# Primary Groq API key (Required in production cloud mode)
GROQ_API_KEY=
# Optional comma-separated list of Groq API keys for failover and rate-limit rotation
GROQ_API_KEYS=
# Default LLM model identifier on Groq (e.g. 'qwen/qwen3.8-27b' or 'llama-3.3-70b-versatile')
DEFAULT_LLM_MODEL=qwen/qwen3.8-27b
# NVIDIA NIM API key for secondary cloud brain failover
NVIDIA_API_KEY=
# NVIDIA NIM base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA fallback model identifier
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Local Ollama endpoint for private mode
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# Pipeline & Tuning Settings (Plan §9)
# ==============================================================================
# Semantic cache cosine similarity threshold (0.0 to 1.0)
CACHE_THRESHOLD=0.96
# Enable cross-encoder re-ranking stage
RERANKER_ENABLED=true
# Cross-encoder relevance floor for early refusal / domain mismatch
RELEVANCE_FLOOR=0.0001
# Enable Hypothetical Document Embeddings (HyDE) retrieval expansion
HYDE_ENABLED=true
# Enable iterative agentic retrieval loop
AGENTIC_ENABLED=true
# Security guardrails: 'on' or 'off' (prompt injection & PII scrubbing)
GUARDS=on
# Maximum neighbor expansion hops/facts in GraphRAG-lite
GRAPH_MAX_EXPANSION=4
# OCR languages for scanned document parsing (e.g. 'eng+hin' or 'en+hi')
OCR_LANGS=eng+hin
# OCR engine provider: 'tesseract' (lightweight) or 'easyocr' (deep learning)
OCR_PROVIDER=tesseract
# Directory path for per-question execution trace JSONL files
TRACES_DIR=data/traces

# ==============================================================================
# Authentication (Clerk - Required in production)
# ==============================================================================
# Clerk backend secret key
CLERK_SECRET_KEY=
# Clerk backend publishable key
CLERK_PUBLISHABLE_KEY=
# Clerk PEM public key for local JWT verification
CLERK_PEM_PUBLIC_KEY=
# Clerk JWKS endpoint URL for live JWKS fetching
CLERK_JWKS_URL=

# ==============================================================================
# Storage & Database (Supabase - Required in production)
# ==============================================================================
# Supabase project REST/PostgREST URL
SUPABASE_URL=
# Supabase service role secret key (never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Payments (Stripe - Required in production)
# ==============================================================================
# Stripe secret API key (test or live mode)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Stripe recurring Price ID for Pro tier
STRIPE_PRICE_ID_PRO=price_pro_test_123
# Redirect URL after successful Stripe checkout
STRIPE_SUCCESS_URL=http://localhost:3000/pricing?success=true
# Redirect URL after cancelled Stripe checkout
STRIPE_CANCEL_URL=http://localhost:3000/pricing?canceled=true

# ==============================================================================
# Channels (Telegram Bot - Required in production for bot integration)
# ==============================================================================
# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram secret webhook token for validating incoming Telegram updates
TELEGRAM_WEBHOOK_SECRET=
