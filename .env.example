# Allcited Configuration Template (.env.example)
# Copy this file to .env and fill in your keys. NEVER commit .env to git!

# Core Environment & Server
ENVIRONMENT=development
PORT=8000
MODE=cloud
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Brain (Required in Phase 2 for cloud mode)
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# Pipeline & Guardrails (Plan §9)
CACHE_THRESHOLD=0.96
GUARDS=on
GRAPH_MAX_EXPANSION=4
OCR_LANGS=eng+hin

# Authentication (Clerk - Required in Phase 4/5)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Storage & Library (Supabase - Required in Phase 5)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Stripe Test Mode - Required in Phase 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Channels (Telegram - Required in Phase 8)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
