# Allcited Configuration Template (.env.example)
# Copy this file to .env and fill in your keys. NEVER commit .env to git!

# Core Environment & Server
ENVIRONMENT=development
PORT=8000
MODE=cloud
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Brain (Required in Phase 2 for cloud mode)
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# Pipeline & Tuning settings (Plan §9)
CACHE_THRESHOLD=0.96
RERANKER_ENABLED=true
RELEVANCE_FLOOR=0.0001
HYDE_ENABLED=true
AGENTIC_ENABLED=true
GUARDS=on
GRAPH_MAX_EXPANSION=4
OCR_LANGS=eng+hin
TRACES_DIR=data/traces

# Authentication (Clerk - Required in Phase 4/5)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_PEM_PUBLIC_KEY=
CLERK_JWKS_URL=

# Storage & Library (Supabase - Required in Phase 5)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Stripe Test Mode - Required in Phase 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=price_pro_test_123
STRIPE_SUCCESS_URL=http://localhost:3000/pricing?success=true
STRIPE_CANCEL_URL=http://localhost:3000/pricing?canceled=true

# Channels (Telegram - Required in Phase 8)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
